# The build context only needs the source. Without excluding target/ and node_modules/,
# just sending the context to the daemon takes minutes; node_modules would also clobber the
# copy pnpm install produced inside the container (incompatible binaries on a Windows/macOS host).
target/
**/node_modules/
.git/
.github/
data/
web/dist/
docs/
.claude/
.env
*.log

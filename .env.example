# Copy this to .env and modify as needed. All configuration goes through environment variables
# with the UTOPIA_ prefix.
UTOPIA_DATABASE_URL=postgres://utopia:utopia@localhost:1517/utopia
UTOPIA_BIND_ADDR=0.0.0.0:1516
# JWT signing secret. Leaving it empty is fine -- the first startup generates one automatically
# and stores it in the database.
# You only need to fill it in to rotate the key, or to align several instances explicitly.
# UTOPIA_JWT_SECRET=
# Directory of the front-end build output (if it exists, the server serves the SPA)
UTOPIA_WEB_DIST=web/dist
# Data directory: the original files (files/) and the full-text index (index/)
UTOPIA_DATA_DIR=data
# Force Secure onto the session cookie. Leaving it empty is fine -- under TLS it is decided
# automatically from X-Forwarded-Proto.
# You only need to turn this on when the reverse proxy does not send that header.
# UTOPIA_COOKIE_SECURE=true
# Open registration; when false only the first user may register, and the rest are opened up by
# an admin
UTOPIA_OPEN_REGISTRATION=true
# Upper bound of the database connection pool. Defaults to 32, aligned with the default worker
# concurrency.
# When the pool is smaller than the concurrency the symptom is requests getting slower, not
# anything anywhere saying "the pool is too small" -- consider this as well when raising worker
# concurrency, and do not exceed Postgres's own max_connections (100 by default).
# UTOPIA_DB_MAX_CONNECTIONS=32

# --- The following few are read by docker-compose; they are not application configuration ---
# Database password. The default value only suits local development; always change it for a
# public deployment.
# UTOPIA_DB_PASSWORD=utopia
# Database port mapping. By default it binds the loopback only, for local development
# connections; change this when the host port is already taken.
# UTOPIA_DB_BIND=127.0.0.1:1517
# When Docker Hub will not pull, swap in any PG16+ image that has pgvector
# UTOPIA_DB_IMAGE=pgvector/pgvector:pg16
# Deploy a specific version; defaults to latest
# UTOPIA_IMAGE=ghcr.io/deeplethe/utopia:0.1.0

# --- Restricted database role (optional, recommended for new deployments) ---
# If unset, the application runs as the database owner: that identity can DROP TRIGGER, and so
# can bypass the ledger's immutability constraints. Once set, the application connects as
# utopia_app instead -- business tables are read and written as usual, while the ledger can only
# be written and read, neither modified nor deleted; migrations go through a separate owner
# connection that is released as soon as it is done.
#
# Note: what this layer blocks is application bugs, SQL injection and leaked connection strings;
# it does not block someone who can log in to the server (psql inside the container is superuser
# without a password). That belongs to server access control.
#
# The role is created by the init script on the first up, so all three have to be given together:
# UTOPIA_APP_DB_PASSWORD=replace-with-a-random-password
# UTOPIA_DATABASE_URL=postgres://utopia_app:that-same-password@db:5432/utopia
# UTOPIA_MIGRATION_URL=postgres://utopia:${UTOPIA_DB_PASSWORD}@db:5432/utopia
#
# For a deployment whose data directory already exists the init script does not run, so the role
# has to be created by hand once:
#   docker compose exec db psql -U utopia -d utopia \
#     -c "CREATE ROLE utopia_app LOGIN PASSWORD 'replace-with-a-random-password';"
# Then set the three above and restart; the migration will grant it the privileges automatically.
